{
  "$schema": "swarmtui/wireframe.v1",
  "name": "swarmtui",
  "version": "0.1.0-dev",
  "description": "Swarmstate orchestrator and management TUI",
  "design": {
    "font": "monospace",
    "engine": "ratatui",
    "borders": "unicode-box-drawing",
    "color_palette": {
      "ok": "green",
      "warning": "yellow",
      "error": "red",
      "idle": "cyan",
      "selected": "white_on_blue",
      "header": "bold_white",
      "dim": "dim"
    },
    "glyphs": {
      "running": "●",
      "idle": "○",
      "offline": "◌",
      "paused": "⏸",
      "escalation": "⚠",
      "pending": "?",
      "success": "✓",
      "fail": "✗",
      "in_progress": "⏳",
      "ok_box": "█",
      "mid_box": "▓▒",
      "low_box": "░",
      "sparkline_chars": "▁▂▃▄▅▆▇█"
    }
  },
  "layout": {
    "type": "3-pane horizontal + 2 header/footer rows",
    "header_rows": 2,
    "status_rows": 1,
    "panes": [
      {
        "id": "left",
        "name": "node_tree",
        "x": 0,
        "w_pct": 25,
        "scrollable": true
      },
      {
        "id": "center",
        "name": "workspace",
        "x": 1,
        "w_pct": 50,
        "scrollable": true
      },
      {
        "id": "right",
        "name": "inspector_logs",
        "x": 2,
        "w_pct": 25,
        "scrollable": true
      }
    ]
  },
  "header_bar": {
    "row_1": {
      "left": [
        "app_name",
        "version"
      ],
      "center": [
        "swarm_name",
        "mode_indicator"
      ],
      "right": [
        "clock"
      ]
    },
    "row_2": {
      "left": [
        "load_avg_1_5_15"
      ],
      "center": [
        "mem_used_total",
        "disk_free_total",
        "battery"
      ],
      "right": [
        "node_count",
        "active_ops",
        "escalations"
      ]
    }
  },
  "footer_status_bar": {
    "fields": [
      "mode",
      "selected_node",
      "selected_node_status",
      "strategy",
      "checkpoint_id",
      "escalation_count",
      "token_budget",
      "notifications",
      "help_hint",
      "quit_hint"
    ]
  },
  "modes": [
    "ORCHESTRATE",
    "MONITOR",
    "EXPERIMENT",
    "AUTO-IMPROVE",
    "RESEARCH",
    "EVAL",
    "MESH"
  ],
  "left_pane": {
    "id": "node_tree",
    "sections": [
      {
        "id": "filter_bar",
        "type": "text_input",
        "placeholder": "🔍 Filter nodes...",
        "key": "/"
      },
      {
        "id": "node_tree_view",
        "type": "tree",
        "root_label": "swarm-root",
        "node_status_dots": {
          "running": "●",
          "idle": "○",
          "offline": "◌",
          "paused": "⏸",
          "escalation": "⚠",
          "pending": "?"
        },
        "edge_badges": [
          "TCP",
          "WG",
          "STREAM",
          "BRIDGE"
        ],
        "expand_keys": "←/→",
        "navigate_keys": "↑/↓",
        "context_keys": [
          "Enter",
          "n",
          "d",
          "r"
        ]
      },
      {
        "id": "selected_node_info",
        "type": "key_value",
        "fields": [
          "name",
          "path",
          "type",
          "status",
          "strategy",
          "ops_count",
          "lora_file",
          "checkpoint_id",
          "peers_count",
          "last_op"
        ],
        "actions": [
          "Edit",
          "Logs",
          "Connect",
          "Kill"
        ]
      },
      {
        "id": "add_node_buttons",
        "type": "button_row",
        "buttons": [
          "+ Add Local",
          "+ Connect Peer",
          "Scan"
        ]
      }
    ]
  },
  "center_pane": {
    "id": "workspace",
    "submodes": {
      "ORCHESTRATE": {
        "tabs": [
          "PLAN",
          "EXECUTE",
          "DIFF",
          "RESULTS"
        ],
        "panels": [
          "operation_composer",
          "execute_runner",
          "diff_viewer",
          "results_table"
        ]
      },
      "MONITOR": {
        "panels": [
          "live_metrics",
          "alerts",
          "node_focus_log"
        ]
      },
      "EXPERIMENT": {
        "panels": [
          "template_gallery",
          "experiment_builder",
          "run_queue",
          "comparison_table"
        ]
      },
      "AUTO-IMPROVE": {
        "panels": [
          "target_config",
          "iterations_log",
          "iteration_detail",
          "trend_chart"
        ]
      },
      "RESEARCH": {
        "panels": [
          "query_bar",
          "source_chips",
          "kit_browser",
          "synthesis"
        ]
      },
      "EVAL": {
        "panels": [
          "pack_selector",
          "live_progress",
          "results"
        ]
      },
      "MESH": {
        "panels": [
          "topology",
          "peer_list",
          "traffic",
          "pool",
          "bridge",
          "gov_audit"
        ]
      }
    }
  },
  "right_pane": {
    "id": "inspector",
    "tabs": [
      "NODE",
      "LOGS",
      "REGISTRY",
      "GOV",
      "MESH"
    ],
    "panels": {
      "NODE": [
        "selected_node",
        "system_info",
        "checkpoint_chain",
        "lora_info",
        "actions"
      ],
      "LOGS": [
        "level_filter",
        "node_filter",
        "op_filter",
        "log_stream"
      ],
      "REGISTRY": [
        "signature_table",
        "sparkline_per_sig",
        "actions"
      ],
      "GOV": [
        "audit_log",
        "pending_decisions",
        "identity_chain",
        "hash_status"
      ],
      "MESH": [
        "topology_diagram",
        "peer_table",
        "pool_status",
        "bridge_config",
        "traffic_stats"
      ]
    }
  },
