#!/home/grave/.prime/agent/kernel-venv/bin/python
"""sp todo — 4-layer task manager CLI (Vision/Epic/Story/Task) with GitHub Issues
parity extension fields.

Wraps the agent's task_manager skill and enforces the 4-layer schema + ext-v1
extension fields (see docs/todo-schema.md, docs/todo-invariants.md,
docs/todo-extensions.md).

Extension fields: labels, milestone, assignees, mentions, reactions, draft,
estimate, actual, due, closed_at, project, effort_score, impact_score, risk,
weight, checklist, links, watchers, priority_boost, swarm_tags.

Custom fields: drop a JSON catalog at ~/.statepod/todo-fields.json.

Usage:
  sp todo add "Title" --layer task [--parent T-0001] [--priority P0]
                     [--label bug,security] [--assignee alice,bob]
                     [--estimate 2h] [--due 2026-09-15] [--risk high]
                     [--effort 8] [--impact 4] [--milestone v1.0]
  sp todo ls    [--layer L] [--status S] [--priority P] [--label X] [--assignee X]
  sp todo show  T-0001
  sp todo start T-0001
  sp todo complete T-0001 [--actual 2.5h]
  sp todo depend T-0001 T-0002 T-0003
  sp todo graph [--fmt ascii|md] [--depth N] [--root T-0001]
  sp todo next  [--limit 3]
  sp todo check [--task T-0001] [--strict]
  sp todo scaffold "I want to <verb> <thing>"
  sp todo field ls|show <name>|add NAME=SPEC
  sp todo sync  push|pull
  sp todo serve [--port 7741] [--all-interfaces]
  sp todo version

Exit codes:
  0 = success, 1 = invalid args, 2 = invariant violation, 3 = not found
"""
import sys, os, json, re, asyncio
from pathlib import Path

import importlib, site

# Ensure task_manager skill is on the path
_skill_root = Path.home() / ".agents" / "skills" / "task-manager" / "src"
if _skill_root.exists():
    sys.path.insert(0, str(_skill_root))
    sys.path.insert(0, str(_skill_root.parent))
tm = importlib.import_module("task_manager")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "py"))
import todo_custom as tc

VALID_LAYERS     = {"vision", "epic", "story", "task"}
VALID_PRIORITIES = {"P0", "P1", "P2", "P3"}


def err(msg, code=1):
    print("sp todo: " + msg, file=sys.stderr)
    sys.exit(code)


def parse_args(argv):
    positional = []
    flags = {}
    i = 1
    while i < len(argv):
        a = argv[i]
        if a.startswith("--"):
            if "=" in a:
                k, v = a[2:].split("=", 1)
                flags[k] = v
                i += 1
            else:
                k = a[2:]
                if i + 1 < len(argv) and not argv[i + 1].startswith("--"):
                    flags[k] = argv[i + 1]
                    i += 2
                else:
                    flags[k] = True
                    i += 1
        else:
            positional.append(a)
            i += 1
    return positional, flags


# Extension field store
def _ext_path():
    p = Path(os.path.expanduser("~/.statepod/task-extensions.json"))
    p.parent.mkdir(parents=True, exist_ok=True)
    return p

def _ext_load():
    p = _ext_path()
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text())
    except Exception:
        return {}

def _ext_save(d):
    _ext_path().write_text(json.dumps(d, indent=2, default=str))

def _ext_get(tid):
    return _ext_load().get(tid, {})

def _ext_set(tid, fields):
    d = _ext_load()
    d.setdefault(tid, {}).update(fields)
    _ext_save(d)


def mirror_md(task):
    try:
        md_dir = Path(os.path.expanduser("~/.statepod/tasks"))
        md_dir.mkdir(parents=True, exist_ok=True)
        tid = task["id"]
        ext = _ext_get(tid)
        lines = [
            "---",
            "id:         " + tid,
            "schema:     todo-schema-v1+ext-v1",
            "layer:      " + task.get("category", "task"),
            "status:     " + task.get("status", "todo"),
            "priority:   " + task.get("priority", "P2"),
            "category:   " + task.get("category", ""),
            "tags:       [" + ", ".join(task.get("tags", [])) + "]",
            "depends:    [" + ", ".join(task.get("deps", [])) + "]",
            "created:    " + task.get("created_at", ""),
            "updated:    " + task.get("updated_at", ""),
        ]
        for fname, fval in ext.items():
            xk = "x_" + fname
            if isinstance(fval, bool):
                lines.append(f"{xk}: {str(fval).lower()}")
            elif isinstance(fval, list):
                lines.append(f"{xk}: [" + ", ".join(str(x) for x in fval) + "]")
            elif isinstance(fval, dict):
                lines.append(f"{xk}: " + json.dumps(fval, separators=(",", ":")))
            elif fval is not None:
                lines.append(f"{xk}: {fval}")
        lines.append("---")
        body = "# " + task["title"] + "\n\n" + task.get("description", "") + "\n"
        (md_dir / (tid + ".md")).write_text("\n".join(lines) + "\n" + body)
    except Exception as e:
        print("sp todo: warning: mirror failed: " + str(e), file=sys.stderr)


def _load_raw():
    store = Path(os.path.expanduser("~/.prime/agent/task-manager/tasks.json"))
    if not store.exists():
        return []
    try:
        return json.loads(store.read_text())
    except Exception:
        return []


# Invariants
def check_layer_parent(task, all_tasks):
    layer = task.get("category", "task")
    deps = task.get("deps", [])
    parents = [t for t in all_tasks if t["id"] in deps]
    if layer == "vision":
        return None
    if layer == "epic":
        if not parents:
            return None
        if not any(p.get("category") == "vision" for p in parents):
            return task["id"] + " (epic) missing vision parent"
        return None
    if layer == "story":
        if not any(p.get("category") == "epic" for p in parents):
            return task["id"] + " (story) missing epic parent"
        return None
    if layer == "task":
        if not (any(p.get("category") == "story" for p in parents)
                or any(p.get("category") == "epic" for p in parents)):
            return task["id"] + " (task) missing story or epic parent"
        return None
    return None


def check_story_acceptance(task, all_tasks=None):
    if task.get("category") != "story":
        return None
    body = (task.get("title", "") + " " + task.get("description", "")).lower()
    if "## acceptance" not in body and "acceptance" not in body:
        return task["id"] + " (story) missing acceptance criteria"
    return None


def check_vision_scope(task, all_tasks=None):
    if task.get("category") != "vision":
        return None
    if len(task.get("description", "")) > 500:
        return task["id"] + " (vision) desc > 500 chars"
    return None


def check_title_len(task, all_tasks=None):
    if len(task.get("title", "")) > 80:
        return task["id"] + " title > 80 chars"
    return None


def check_desc_len(task, all_tasks=None):
    d = task.get("description", "")
    if 0 < len(d) < 20:
        return task["id"] + " desc < 20 chars"
    return None


CHECKS = [check_layer_parent, check_story_acceptance, check_vision_scope,
          check_title_len, check_desc_len]


def check_ext_layer(task, all_tasks):
    tid = task["id"]
    ext = _ext_get(tid)
    layer = task.get("category", "task")
    cat = tc.get_catalog()
    violations = []
    for fname in ext:
        if fname in cat and not cat[fname].applicable(layer):
            violations.append(f"{tid} I11: {fname!r} not applicable to layer {layer!r}")
    return violations


def check_ext_value(task, all_tasks):
    tid = task["id"]
    ext = _ext_get(tid)
    violations = []
    for fname, fval in ext.items():
        ok, err = tc.validate_value(fname, fval)
        if not ok:
            violations.append(f"{tid} I12: {err}")
    return violations


EXT_CHECKS = [check_ext_layer, check_ext_value]


# CLI commands
async def cmd_add(pos, flags):
    if not pos:
        err("add requires a title")
    title = pos[0]
    layer = flags.get("layer", "task")
    if layer not in VALID_LAYERS:
        err("layer must be one of " + str(sorted(VALID_LAYERS)) + ", got " + repr(layer))
    parent = flags.get("parent")
    deps_field = flags.get("deps", "")
    if isinstance(deps_field, list):
        deps = deps_field
    elif deps_field:
        deps = [d.strip() for d in deps_field.split(",") if d.strip()]
    else:
        deps = []
    if parent:
        deps = [parent] + deps
    priority = flags.get("priority", "P2")
    if priority not in VALID_PRIORITIES:
        err("priority must be " + str(sorted(VALID_PRIORITIES)))
    description = flags.get("description", "")
    tags_field = flags.get("tags", "")
    if isinstance(tags_field, list):
        tags = tags_field
    elif tags_field:
        tags = [t.strip() for t in tags_field.split(",") if t.strip()]
    else:
        tags = []
    cat = tc.get_catalog()
    ext_flags = {k: v for k, v in flags.items() if k in cat}
    ext_fields = tc.parse_flags(ext_flags)
    errs = tc.validate_all(ext_fields)
    if errs:
        for e in errs:
            print("sp todo: " + e, file=sys.stderr)
        err("extension field validation failed", code=2)
    bad = [n for n in ext_fields if not tc.layer_applicable(n, layer)]
    if bad:
        err(f"fields not applicable to layer {layer!r}: {bad}", code=2)
    tid = await tm.add(title, description, priority, layer, tags, deps)
    if ext_fields:
        _ext_set(tid, ext_fields)
    raw = _load_raw()
    task = next((t for t in raw if t["id"] == tid), None)
    if task:
        mirror_md(task)
    print(tid)
    return 0


async def cmd_ls(pos, flags):
    layer = flags.get("layer")
    status = flags.get("status")
    priority = flags.get("priority")
    label = flags.get("label")
    assignee = flags.get("assignee")
    print(await tm.list_tasks(status=status, category=layer, priority=priority, verbose=True))
    if label or assignee:
        ext = _ext_load()
        raw = _load_raw()
        if label:
            raw = [t for t in raw if label in ext.get(t["id"], {}).get("labels", [])]
        if assignee:
            raw = [t for t in raw if assignee in ext.get(t["id"], {}).get("assignees", [])]
        print(f"Filtered (label={label}, assignee={assignee}): {len(raw)} task(s)")
        for t in raw:
            e = ext.get(t["id"], {})
            es = " ".join(f"{k}={v}" for k, v in e.items() if k in ("labels", "assignees", "milestone"))
            print("  " + t["id"] + "  " + str(t.get("title", "")) + "  [" + es + "]")
    return 0


async def cmd_show(pos, flags):
    if not pos:
        err("show requires a task id")
    print(await tm.show(pos[0]))
    ext = _ext_get(pos[0])
    if ext:
        print()
        print("Extension fields (ext-v1):")
        cat = tc.get_catalog()
        for k, v in sorted(ext.items()):
            spec = cat.get(k)
            note = ""
            if spec and spec.doc:
                note = " (" + spec.doc + ")"
            val = v
            if not isinstance(v, str):
                val = json.dumps(v)
            print("  " + k + ": " + str(val) + note)
    return 0


async def cmd_start(pos, flags):
    if not pos:
        err("start requires a task id")
    print(await tm.start(pos[0]))
    return 0


async def cmd_complete(pos, flags):
    if not pos:
        err("complete requires a task id")
    tid = pos[0]
    print(await tm.complete(tid))
    from datetime import datetime, timezone
    updates = {}
    if "actual" in flags:
        updates["actual"] = flags["actual"]
    updates.setdefault("closed_at", datetime.now(timezone.utc).isoformat())
    _ext_set(tid, updates)
    raw = _load_raw()
    task = next((t for t in raw if t["id"] == tid), None)
    if task:
        mirror_md(task)
    return 0


async def cmd_depend(pos, flags):
    if len(pos) < 2:
        err("depend requires TASK_ID and one or more DEPENDS_ON")
    print(await tm.depend(pos[0], pos[1:]))
    return 0


async def cmd_graph(pos, flags):
    fmt = flags.get("fmt", "ascii")
    root = flags.get("root")
    print(await tm.graph(fmt=fmt, task_id=root))
    return 0


async def cmd_next(pos, flags):
    limit = int(flags.get("limit", 3))
    print(await tm.next_tasks(limit=limit))
    return 0


async def cmd_check(pos, flags):
    target = flags.get("task")
    raw = _load_raw()
    if not raw:
        err("no tasks found", code=3)
    ids = [t["id"] for t in raw if not target or t["id"] == target]
    if target and not ids:
        err("task not found: " + target, code=3)
    violations = []
    for t in raw:
        if t["id"] not in ids:
            continue
        for check in CHECKS:
            v = check(t, raw)
            if v:
                violations.append(v)
        for check in EXT_CHECKS:
            for v in check(t, raw):
                if v:
                    violations.append(v)
    if violations:
        print("VIOLATIONS:")
        for v in violations:
            print("  " + v)
        return 2
    print("OK: " + str(len(raw)) + " task(s) passed all checks (4-layer + ext-v1)")
    return 0


async def cmd_scaffold(pos, flags):
    if not pos:
        err("scaffold requires a phrase")
    phrase = " ".join(pos)
    m = re.match(r"(?i)i\s+want\s+to\s+(\w+)\s+(.+)", phrase)
    if not m:
        err("could not parse intent: " + repr(phrase))
    verb = m.group(1).lower()
    obj = m.group(2).strip()
    V = {"build": "vision", "ship": "vision", "launch": "vision", "design": "epic",
         "implement": "epic", "add": "epic", "fix": "story", "refactor": "story",
         "test": "story", "document": "task", "research": "task", "rename": "task"}
    layer = V.get(verb, "task")
    print("verb=" + verb + " object=" + repr(obj) + " -> layer=" + layer)
    print("Run: sp todo add " + repr(obj) + " --layer " + layer)
    return 0


async def cmd_auto(pos, flags):
    """Auto-generate a 4-layer todo chain from a goal phrase.
    
    Usage: sp todo auto "<goal>"
    
    Creates: Vision -> Epic -> Story -> Task
    Each layer depends on its parent.
    """
    if not pos:
        err("auto requires a goal phrase")
    goal = " ".join(pos)
    priority = flags.get("priority", "P1")
    
    # Step 1: Create Vision
    v_title = goal[:80] if len(goal) <= 80 else goal[:77] + "..."
    v_id = await tm.add(
        title=v_title,
        description="Auto-generated vision: " + goal,
        priority=priority,
        category="vision",
        layer="vision",
        tags=["auto", "4-layer"],
    )
    print("Created Vision: " + v_id + " - " + v_title)
    
    # Step 2: Create Epic (depends on Vision)
    e_title = "Implement: " + goal[:74]
    e_id = await tm.add(
        title=e_title,
        description="Deliverable for vision " + v_id + ": " + goal,
        priority=priority,
        category="epic",
        layer="epic",
        deps=[v_id],
    )
    print("Created Epic:   " + e_id + " - " + e_title)
    
    # Step 3: Create Story (depends on Epic)
    s_title = "Story: " + goal[:71]
    s_id = await tm.add(
        title=s_title,
        description="One-commit story for " + e_id + ": " + goal,
        priority=priority,
        category="story",
        layer="story",
        deps=[e_id],
    )
    print("Created Story:  " + s_id + " - " + s_title)
    
    # Step 4: Create Task (depends on Story)
    t_title = "Task: " + goal[:74]
    t_id = await tm.add(
        title=t_title,
        description="Atomic task for " + s_id + ": " + goal,
        priority=priority,
        category="task",
        layer="task",
        deps=[s_id],
    )
    print("Created Task:   " + t_id + " - " + t_title)
    print()
    print("Chain: " + v_id + " -> " + e_id + " -> " + s_id + " -> " + t_id)
    return 0


async def cmd_git(pos, flags):
    """Auto-create tasks from recent git commits.
    
    Usage: sp todo git [--repo PATH] [--count N] [--skip-merge]
    
    Walks recent commits, extracts meaningful messages, creates a 4-layer
    todo chain for each. Skips chore/ci/merge commits by default.
    """
    import subprocess, re, asyncio
    
    repo = flags.get("repo", ".")
    count = int(flags.get("count", 5))
    skip_merge = "merge" not in flags  # default: skip merges
    
    # Get commit messages
    fmt = "%H|%s|%an"
    r = subprocess.run(
        ["git", "log", f"--format={fmt}", f"-{count}"],
        capture_output=True, text=True, cwd=repo
    )
    if r.returncode != 0:
        err("git log failed: " + r.stderr)
    
    # Parse commits
    commits = []
    for line in r.stdout.strip().split("\n"):
        if not line:
            continue
        parts = line.split("|", 2)
        if len(parts) < 2:
            continue
        sha, msg, author = parts[0], parts[1], parts[2] if len(parts) > 2 else ""
        
        # Skip merges unless --no-skip-merge
        if skip_merge and "merge" in msg.lower():
            continue
        # Skip chore/ci/boot/deps commits
        skip_prefixes = ["chore:", "ci:", "deps:", "build:", "bump:", "fixup!", "squash!"]
        if any(msg.lower().startswith(p) for p in skip_prefixes):
            continue
        
        commits.append((sha, msg.strip(), author))
    
    if not commits:
        print("No meaningful commits found.")
        return 0
    
    print(f"Found {len(commits)} commits -> creating {len(commits)} task chains")
    print()
    
    # Create a chain per commit
    created = []
    for sha, msg, author in commits:
        # Strip prefix like "fix: " or "feat: "
        clean = re.sub(r"^\w+(\([\w-]+\))?:\s*", "", msg).strip()
        if not clean:
            clean = msg  # fallback
        
        # Create chain
        v_id = await tm.add(
            title=clean[:80],
            description=f"From commit {sha[:8]}: {msg} (by {author})",
            priority="P2",
            category="vision",
            layer="vision",
            tags=["git-hook", "auto"],
        )
        e_id = await tm.add(
            title="Implement: " + clean[:74],
            description=f"Epic from commit {sha[:8]}: {msg}",
            priority="P2",
            category="epic",
            layer="epic",
            deps=[v_id],
        )
        s_id = await tm.add(
            title="Story: " + clean[:71],
            description=f"Story from commit {sha[:8]}: {msg}",
            priority="P2",
            category="story",
            layer="story",
            deps=[e_id],
        )
        t_id = await tm.add(
            title="Task: " + clean[:74],
            description=f"Task from commit {sha[:8]}: {msg}",
            priority="P2",
            category="task",
            layer="task",
            deps=[s_id],
        )
        print(f"  {sha[:8]}: {v_id} -> {e_id} -> {s_id} -> {t_id}")
        print(f"    {msg[:80]}")
        created.append((v_id, e_id, s_id, t_id))
    
    print()
    print(f"Created {len(created)} chains. Start with: sp todo start {created[0][0]}")
    return 0


async def cmd_field(pos, flags):
    # Field catalog: ls|show|add
    sub = pos[0] if pos else "ls"
    cat = tc.get_catalog()
    if sub == "ls":
        print("Extension field catalog (ext-v1, " + str(len(cat)) + " fields):")
        for name in sorted(cat.keys()):
            spec = cat[name]
            layers = ",".join(spec.layers)
            print("  " + name.ljust(20) + " " + spec.ftype.ljust(12) + " [" + layers + "]")
            if spec.doc:
                print("                 " + spec.doc)
        return 0
    if sub == "show":
        name = pos[1] if len(pos) > 1 else None
        if not name:
            err("field show requires a field name")
        spec = cat.get(name)
        if not spec:
            err("unknown field: " + repr(name) + " (try: sp todo field ls)")
        print("Field: " + name)
        print("  type    : " + spec.ftype)
        print("  layers  : " + str(spec.layers))
        print("  default : " + repr(spec.default))
        print("  choices : " + str(spec.choices))
        print("  range   : " + str(spec.min_val) + ".." + str(spec.max_val))
        print("  doc     : " + spec.doc)
        return 0
    if sub == "add":
        spec_str = pos[1] if len(pos) > 1 else ""
        if "=" not in spec_str:
            err("field add requires NAME=FTYPE or NAME=json")
        name, rest = spec_str.split("=", 1)
        try:
            data = json.loads(rest)
        except json.JSONDecodeError:
            data = {"ftype": rest.strip()}
        user_cat = Path.home() / ".statepod" / "todo-fields.json"
        user_cat.parent.mkdir(parents=True, exist_ok=True)
        existing = {}
        if user_cat.exists():
            try:
                existing = json.loads(user_cat.read_text())
            except Exception:
                pass
        existing[name.strip()] = data
        user_cat.write_text(json.dumps(existing, indent=2))
        print("Added custom field " + repr(name.strip()) + " -> " + str(user_cat))
        print("Restart sp todo to pick up the new field.")
        return 0
    err("unknown field subcommand: " + repr(sub) + " (ls|show|add)", code=1)


async def cmd_version(pos, flags):
    print("sp todo v0.2.0 (4-layer schema v1 + ext-v1)")
    return 0


async def cmd_sync(pos, flags):
    """Sync tasks to/from a remote git repo.
    
    Usage:
      sp todo sync push          Push local tasks to remote
      sp todo sync pull          Pull tasks from remote
      sp todo sync status        Show sync status
    
    Requires a statepod-tasks git remote configured at:
      ~/.statepod/tasks-remote (git@github.com:grave0x/statepod-tasks.git)
    """
    import subprocess, asyncio
    
    sub = pos[0] if pos else "status"
    remote_path = os.path.expanduser("~/.statepod/tasks-remote")
    
    if sub == "status":
        # Check if tasks dir is a git repo
        tasks_dir = os.path.expanduser("~/.statepod/tasks")
        r = subprocess.run(["git", "rev-parse", "--git-dir"],
                          capture_output=True, text=True, cwd=tasks_dir)
        if r.returncode == 0:
            # Get status
            r2 = subprocess.run(["git", "status", "--porcelain"],
                               capture_output=True, text=True, cwd=tasks_dir)
            changes = len(r2.stdout.strip().split("\n")) if r2.stdout.strip() else 0
            print(f"Tasks dir is a git repo. {changes} uncommitted changes.")
            # Show ahead/behind
            r3 = subprocess.run(["git", "log", "--oneline", "@{u}..HEAD"],
                               capture_output=True, text=True, cwd=tasks_dir)
            ahead = len(r3.stdout.strip().split("\n")) if r3.stdout.strip() else 0
            print(f"  Local commits ahead of remote: {ahead}")
        else:
            print("Tasks dir is not a git repo.")
            if os.path.exists(remote_path):
                print(f"  Remote configured: {open(remote_path).read().strip()}")
            else:
                print("  No remote configured. Run: sp todo sync init <git-url>")
        return 0
    
    if sub == "init":
        url = pos[1] if len(pos) > 1 else ""
        if not url:
            err("sync init requires a git URL")
        tasks_dir = os.path.expanduser("~/.statepod/tasks")
        # Init git repo
        r = subprocess.run(["git", "init"], capture_output=True, text=True, cwd=tasks_dir)
        if r.returncode != 0 and "already exists" not in r.stderr:
            err("git init failed: " + r.stderr)
        # Add remote
        r2 = subprocess.run(["git", "remote", "add", "origin", url],
                           capture_output=True, text=True, cwd=tasks_dir)
        if r2.returncode != 0:
            # Remote might already exist
            r3 = subprocess.run(["git", "remote", "set-url", "origin", url],
                              capture_output=True, text=True, cwd=tasks_dir)
        # Save remote path
        os.makedirs(os.path.dirname(remote_path), exist_ok=True)
        with open(remote_path, "w") as f:
            f.write(url + "\n")
        # Create initial commit
        r4 = subprocess.run(["git", "add", "."], capture_output=True, text=True, cwd=tasks_dir)
        r5 = subprocess.run(["git", "commit", "-m", "Initial: statepod tasks"],
                          capture_output=True, text=True, cwd=tasks_dir)
        print(f"Initialized tasks git repo at {tasks_dir}")
        print(f"Remote: {url}")
        print(f"Run: sp todo sync push")
        return 0
    
    if sub == "push":
        tasks_dir = os.path.expanduser("~/.statepod/tasks")
        r = subprocess.run(["git", "add", "."], capture_output=True, text=True, cwd=tasks_dir)
        r2 = subprocess.run(["git", "commit", "-m", "Auto-sync tasks"],
                          capture_output=True, text=True, cwd=tasks_dir)
        if "nothing to commit" in r2.stdout:
            print("Nothing to push — tasks are up to date.")
        else:
            print("Committed changes.")
        r3 = subprocess.run(["git", "push", "-u", "origin", "main"],
                           capture_output=True, text=True, cwd=tasks_dir, timeout=30)
        if r3.returncode != 0:
            print("Push failed: " + r3.stderr)
        else:
            print("Pushed to remote.")
        return 0
    
    if sub == "pull":
        tasks_dir = os.path.expanduser("~/.statepod/tasks")
        r = subprocess.run(["git", "pull", "--rebase", "origin", "main"],
                          capture_output=True, text=True, cwd=tasks_dir, timeout=30)
        if r.returncode != 0:
            print("Pull failed: " + r.stderr)
        else:
            print("Pulled from remote.")
            print(r.stdout[:500])
        return 0
    
    err("unknown sync subcommand: " + repr(sub) + ". try: push | pull | status | init <url>")


async def cmd_serve(pos, flags):
    """Serve tasks as a JSON HTTP API (text-mode, subprocess-based).
    
    Usage: sp todo serve [--port PORT] [--all-interfaces]
    
    Endpoints:
      GET /           — list tasks as JSON
      GET /<id>      — task details as JSON
      GET /graph     — task graph
    """
    import json, subprocess, threading
    from http.server import HTTPServer, BaseHTTPRequestHandler
    from urllib.parse import urlparse, parse_qs
    
    port = int(flags.get("port", 7741))
    host = "0.0.0.0" if flags.get("all-interfaces") else "127.0.0.1"
    sw_path = "/home/grave/.local/bin/sp-todo"
    
    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            try:
                parsed = urlparse(self.path)
                path = parsed.path
                qs = parse_qs(parsed.query)
                
                if path == "/" or path == "":
                    args = ["ls", "--limit", "200"]
                    for k, v in qs.items():
                        if k in ("status", "layer", "priority"):
                            args += ["--" + k, v[0]]
                    r = subprocess.run(
                        [sys.executable, sw_path] + args,
                        capture_output=True, text=True, timeout=10
                    )
                    tasks = []
                    for line in r.stdout.split("\n"):
                        parts = line.split(None, 4)
                        if len(parts) >= 4 and parts[0].startswith("T-"):
                            tasks.append({
                                "id": parts[0],
                                "status": parts[1],
                                "priority": parts[2],
                                "title": parts[3] if len(parts) > 3 else "",
                                "category": parts[4].strip() if len(parts) > 4 else "",
                            })
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Access-Control-Allow-Origin", "*")
                    self.end_headers()
                    self.wfile.write(json.dumps(tasks, indent=2).encode())
                
                elif path == "/graph":
                    r = subprocess.run(
                        [sys.executable, sw_path, "graph", "--root",
                         qs.get("root", [""])[0]],
                        capture_output=True, text=True, timeout=10
                    )
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Access-Control-Allow-Origin", "*")
                    self.end_headers()
                    self.wfile.write(json.dumps({"graph": r.stdout}).encode())
                
                elif path.startswith("/") and len(path) > 1:
                    task_id = path[1:]
                    r = subprocess.run(
                        [sys.executable, sw_path, "show", task_id],
                        capture_output=True, text=True, timeout=10
                    )
                    if r.returncode == 0:
                        self.send_response(200)
                        self.send_header("Content-Type", "application/json")
                        self.send_header("Access-Control-Allow-Origin", "*")
                        self.end_headers()
                        self.wfile.write(r.stdout.encode())
                    else:
                        self.send_response(404)
                        self.send_header("Content-Type", "application/json")
                        self.end_headers()
                        self.wfile.write(b'{"error":"not found"}')
                else:
                    self.send_response(404)
                    self.end_headers()
            
            except Exception as e:
                self.send_response(500)
                self.end_headers()
                self.wfile.write(json.dumps({"error": str(e)}).encode())
        
        def log_message(self, fmt, *args):
            pass
    
    print(f"Task server running at http://{host}:{port}/")
    print("Endpoints: GET /, GET /<id>, GET /graph")
    print("Press Ctrl+C to stop.")
    
    server = HTTPServer((host, port), Handler)
    
    def run():
        server.serve_forever()
    
    thread = threading.Thread(target=run, daemon=True)
    thread.start()
    
    try:
        while thread.is_alive():
            thread.join(timeout=1)
    except KeyboardInterrupt:
        server.shutdown()
        print("\nServer stopped.")
    
    return 0




async def cmd_dogfood(pos, flags):
    """Self-check: verify the 4-layer system works end-to-end.
    
    Usage: sp todo dogfood
    
    Runs a complete cycle: create chain → verify schema → complete → graph.
    Exits 0 if all checks pass.
    """
    import asyncio, subprocess, sys
    
    test_goal = "Auto-dogfood test: " + __import__("datetime").datetime.now().isoformat()
    
    print("=== statepod dogfood self-check ===")
    print()
    
    # 1. Create a chain
    print("1. Creating 4-layer chain...")
    r = await tm.add(
        title=test_goal,
        description="Dogfood test: auto-generated",
        priority="P3",
        category="vision",
        layer="vision",
        tags=["dogfood", "test"],
    )
    v_id = r
    e_id = await tm.add(
        title="Implement: " + test_goal[:74],
        description="Dogfood epic",
        priority="P3",
        category="epic",
        layer="epic",
        deps=[v_id],
    )
    s_id = await tm.add(
        title="Story: " + test_goal[:71],
        description="Dogfood story",
        priority="P3",
        category="story",
        layer="story",
        deps=[e_id],
    )
    t_id = await tm.add(
        title="Task: " + test_goal[:74],
        description="Dogfood task",
        priority="P3",
        category="task",
        layer="task",
        deps=[s_id],
    )
    print(f"   Created: {v_id} -> {e_id} -> {s_id} -> {t_id}")
    
    # 2. Verify dependencies (each layer depends on its parent)
    print("2. Verifying schema invariants...")
    task_d = await tm.show(t_id)
    story_d = await tm.show(s_id)
    epic_d = await tm.show(e_id)
    vision_d = await tm.show(v_id)
    
    deps_ok = True
    
    # Verify task -> story -> epic -> vision chain
    if s_id not in task_d:
        deps_ok = False
        print(f"   FAIL: task {t_id} missing story dep {s_id}")
    if e_id not in story_d:
        deps_ok = False
        print(f"   FAIL: story {s_id} missing epic dep {e_id}")
    if v_id not in epic_d:
        deps_ok = False
        print(f"   FAIL: epic {e_id} missing vision dep {v_id}")
    
    # Vision should have no parent deps
    if "depends" in vision_d and vision_d.count("depends") > 1:
        deps_ok = False
        print(f"   FAIL: vision {v_id} has unexpected deps")
    
    print(f"   Schema invariants: {'PASS' if deps_ok else 'FAIL'}")
    
    # 3. Mark complete
    print("3. Marking task complete...")
    await tm.complete(t_id)
    print(f"   Completed: {t_id}")
    
    # 4. Verify graph
    print("4. Verifying graph output...")
    graph = await tm.graph(fmt="ascii", task_id=v_id)
    graph_ok = v_id in graph and e_id in graph
    print(f"   Graph contains chain: {'YES' if graph_ok else 'NO'}")
    
    # 5. Cleanup
    print("5. Cleaning up test chain...")
    await tm.cancel(v_id)
    print(f"   Cleaned up: {v_id}")
    
    all_ok = deps_ok and graph_ok
    print()
    if all_ok:
        print("=== dogfood PASSED ===")
    else:
        print("=== dogfood FAILED ===")
        print("Schema or graph invariants violated.")
    
    return 0 if all_ok else 1





SUBCOMMANDS = {
    "add":      cmd_add,
    "ls":       cmd_ls,
    "list":     cmd_ls,
    "show":     cmd_show,
    "start":    cmd_start,
    "complete": cmd_complete,
    "done":     cmd_complete,
    "depend":   cmd_depend,
    "graph":    cmd_graph,
    "next":     cmd_next,
    "check":    cmd_check,
    "scaffold": cmd_scaffold,
    "auto":      cmd_auto,
    "git":       cmd_git,
    "dogfood":   cmd_dogfood,
    "field":    cmd_field,
    "sync":     cmd_sync,
    "serve":    cmd_serve,
    "version":  cmd_version,
    "help":     lambda p, f: print(__import__("sys").modules[__name__].__doc__),
}


def main(argv):
    if len(argv) < 2:
        print(__import__("sys").modules[__name__].__doc__)
        return 1
    sub = argv[1]
    if sub not in SUBCOMMANDS:
        err("unknown subcommand: " + repr(sub) + ". try: sp todo help")
    pos, flags = parse_args(argv[1:])
    handler = SUBCOMMANDS[sub]
    return asyncio.run(handler(pos, flags))


if __name__ == "__main__":
    sys.exit(main(sys.argv) or 0)
